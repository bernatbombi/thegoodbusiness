server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # nginx's bundled mime.types doesn't map .mjs — without this it falls
    # back to application/octet-stream and browsers refuse to run it as a
    # module script. `include` first so other extensions keep their types;
    # a bare `types {}` block here would replace the whole table.
    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }

    location / {
        try_files $uri /index.html;
    }
}
